<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://github.com/CtznSniiips/Lobby" version="0.9.17" viewmodes="maximized">
  <tizen:application id="lobbyTV001.Lobby" package="lobbyTV001" required_version="6.5"/>
  <content src="index.html"/>
  <name>Lobby</name>
  <icon src="icon.png"/>
  <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
  <tizen:profile name="tv-samsung"/>
  <!-- Lobby: the paired Emby server (any LAN address the owner enters) and TMDB posters. -->
  <access origin="*" subdomains="true"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"/>
  <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
  <tizen:privilege name="http://tizen.org/privilege/application.info"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.window"/>
  <!-- Lobby is wired in as the TV's native Home replacement (see docs/tv-status.md), so it should stay
       resident like Samsung's own Home rather than being killed whenever another app is foregrounded.
       background-support="disable" (the generic widget default) forced a full cold WebKit restart on the
       next physical Home-button press, which the TV's own loading animation isn't tuned to wait out -
       the press looked hung; a second press then hit the now-fully-loaded (or re-cached) process and felt instant. -->
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="enable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
